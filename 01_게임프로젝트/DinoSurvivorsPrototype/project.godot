; Engine configuration file.
; 이 파일이 있는 폴더를 Godot에서 "프로젝트로 열기"하면 됩니다.

config_version=5

[application]

config/name="Dinosaur Survivors Prototype"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

RunState="*res://autoload/run_state.gd"
SkillDatabase="*res://autoload/skill_database.gd"
WaveManager="*res://autoload/wave_manager.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
