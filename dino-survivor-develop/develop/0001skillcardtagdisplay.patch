diff --git "a/dino-survivor-develop/DinoSurvivors_Workspace/00_\352\270\260\355\232\215/\352\263\265\353\243\241_\353\261\200\354\204\234\353\235\274\354\235\264\355\201\254_\352\270\260\355\232\215\354\204\234.md" "b/dino-survivor-develop/DinoSurvivors_Workspace/00_\352\270\260\355\232\215/\352\263\265\353\243\241_\353\261\200\354\204\234\353\235\274\354\235\264\355\201\254_\352\270\260\355\232\215\354\204\234.md"
