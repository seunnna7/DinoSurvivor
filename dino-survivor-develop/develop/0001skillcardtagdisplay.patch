--- "a/dino-survivor-develop/DinoSurvivors_Workspace/00_\352\270\260\355\232\215/\352\263\265\353\243\241_\353\261\200\354\204\234\353\235\274\354\235\264\355\201\254_\352\270\260\355\232\215\354\204\234.md"
+++ "b/dino-survivor-develop/DinoSurvivors_Workspace/00_\352\270\260\355\232\215/\352\263\265\353\243\241_\353\261\200\354\204\234\353\235\274\354\235\264\355\201\254_\352\270\260\355\232\215\354\204\234.md"
@@ -123,6 +123,7 @@ Lv.1 ── Lv.2 ── Lv.3 ── Lv.4 ── Lv.5(만렙)
 - 스킬은 `SkillData.tags: Array[StringName]`로 다중 분류됨 (예: `melee`, `summon`, `projectile`, `bomb`). 4.2 표의 값은 변주 체크용으로 하나씩만 부여했지만, 스킬 하나가 여러 태그를 동시에 가질 수 있는 구조
 - **용도**: (1) 신규 스킬 추가 시 기존 아키타입과 안 겹치는지 변주 체크, (2) 향후 태그를 겨냥한 버프의 타겟팅 키 (예: "소환수 강화" 효과가 `summon` 태그를 가진 스킬 전체에 적용)
 - 진화/합체로 스킬이 교체될 때 태그도 새로 부여됨 — 진화형이 원본과 다른 정체성을 가지면(예: 근접형이 진화하며 광역형이 되는 경우) 태그도 그에 맞게 갈아낌
+- **내부 id ↔ 노출 라벨 분리**: `tags`에 담기는 값(`summon` 등)은 시스템 내부 식별자일 뿐, 화면에는 `TagDatabase`(Autoload, `autoload/tag_database.gd`) 안의 `DISPLAY_NAMES` 딕셔너리를 거쳐 한글 라벨(`소환수` 등)로 변환되어 노출됨. 새 태그를 추가하면 이 딕셔너리에 한 줄만 추가하면 됨 (스킬 카드는 `TagDatabase.joined_display_names(tags)`로 조회)
 
 #### 합체 재료 구조
 - **재료 개수**: 기본 2개. 특정 레시피는 예외적으로 3개까지 허용 — `FusionRecipe.ingredients`가 배열이라 스키마 변경 없이 지원
@@ -309,7 +310,7 @@ Lv.1 ── Lv.2 ── Lv.3 ── Lv.4 ── Lv.5(만렙)
 9. 스탯 중첩 규칙(`additive_percent` 통일) 최종 확정 — 현재는 제안 상태
 10. 나머지 스킬 8종의 정확한 수치(데미지/쿨다운/범위) — `공룡_뱀서라이크_기획데이터.xlsx`의 Skills 시트에서 관리
 11. 스킬별 Lv3 "특징적 강화"의 구체 내용 (스킬 9종 각각 무엇이 바뀌는지) — 미정
-12. 태그 목록(`melee`/`summon`/`projectile`/`bomb` 등) 전체 확정 및 명명 규칙 — 지금은 예시 수준
+12. 태그 목록(`melee`/`summon`/`projectile`/`bomb` 등) 전체 확정 및 명명 규칙 — 노출 라벨 매핑 방식(`TagDatabase`)은 확정, 태그 어휘 자체는 앞으로 계속 늘어날 예정이라 계속 갱신 필요
 13. 태그 대상 버프(예: "소환수 강화")의 실제 발생 경로(레벨업 카드/메타 강화/숙련도 중 어디서 나올지) — 아직 소비처 없음, 스키마만 준비된 상태
 14. `공룡_뱀서라이크_기획데이터.xlsx`의 Skills 시트에서 `archetype`/`is_unique_active` 컬럼을 `tags`(다중값)로 교체 반영 필요
 
diff --git a/dino-survivor-develop/autoload/tag_database.gd b/dino-survivor-develop/autoload/tag_database.gd
new file mode 100644
index 0000000..586faeb
--- /dev/null
+++ b/dino-survivor-develop/autoload/tag_database.gd
@@ -0,0 +1,26 @@
+extends Node
+## SkillData.tags의 내부 id(예: "summon")를 플레이어에게 보여줄 한글 라벨(예: "소환수")로 변환합니다.
+## 새 태그를 추가하면 DISPLAY_NAMES에 한 줄만 추가하면 됩니다 (기획서 4.3.1).
+
+const DISPLAY_NAMES: Dictionary = {
+	&"melee": "근접",
+	&"orbit": "회전",
+	&"dash": "돌진",
+	&"summon": "소환수",
+	&"burst": "버스트",
+	&"ranged_pierce": "관통",
+	&"ranged_spread": "확산",
+	&"suction": "흡입",
+	&"passive": "패시브",
+}
+
+## 매핑에 없는 태그(추가 직후 라벨을 아직 안 붙인 경우 등)는 원본 id를 그대로 보여줌
+func display_name(tag: StringName) -> String:
+	return DISPLAY_NAMES.get(tag, String(tag))
+
+## 스킬 카드 등에서 태그 여러 개를 한 줄로 이어붙여 보여줄 때 사용
+func joined_display_names(tags: Array[StringName], separator: String = " · ") -> String:
+	var names: PackedStringArray = []
+	for tag in tags:
+		names.append(display_name(tag))
+	return separator.join(names)
