 .../autoload/tag_database.gd                  | 26 +++++++++++++++++++
 dino-survivor-develop/project.godot           |  1 +
 .../scenes/ui/SkillCard.tscn                  |  9 +++++++
 .../scripts/ui/skill_card.gd                  |  3 +++
 5 files changed, 41 insertions(+), 1 deletion(-)
